// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  username       String
  profilePicture String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Model {
  id             String                  @id @default(uuid())
  name           String
  age            Int
  type           ModelTypesEnum
  ethnicity      ModelEthnicityEnum
  eyeColor       ModelEyeColorEnum
  bald           Boolean
  prompt         String?
  tensorPath     String?
  trainingStatus ModelTrainingStatusEnum @default(Pending)
  zipUrls        String
  outputImages   OutputImage[]
  userId         String
  falAiRequestId String?
  createdAt      DateTime                @default(now())  
  updatedAt      DateTime                @updatedAt

}

model OutputImage {
  id             String     @id @default(uuid())
  imageUrl       String     @default("")
  modelId        String
  userId         String
  prompt         String
  status         StatusEnum @default(Pending)
  model          Model      @relation(fields: [modelId], references: [id])
  falAiRequestId String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

}

model Packs {
  id     String        @id @default(uuid())
  name   String
  prompt PackPrompts[]
}

model PackPrompts {
  id     String @id @default(uuid())
  prompt String
  packId String
  pack   Packs  @relation(fields: [packId], references: [id])
}

enum ModelTypesEnum {
  Male
  Female
  Others
}

enum ModelEthnicityEnum {
  White
  Black
  AsianAmerican
  EastAsian
  SouthEastAsian
  SouthAsian
  MiddleEastern
  Hispanic
}

enum ModelEyeColorEnum {
  Brown
  Blue
  Hazel
  Gray
}

enum StatusEnum {
  Pending
  Generated
  Failed
}

enum ModelTrainingStatusEnum {
  Pending
  Training
  Completed
  Failed
}
