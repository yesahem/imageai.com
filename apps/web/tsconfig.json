{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./app/*"],
      "@/lib/api-client": ["./lib/api-client"],
      "@/lib/api": ["./lib/api"],
      "@/hooks/*": ["./hooks/*"],
      "@/types": ["./types"],
      "@/types/*": ["./types/*"],
      "@/config": ["./app/config"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
